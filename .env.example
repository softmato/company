# ── Company ────────────────────────────────────────────────
# Legal name is not final. Never hardcode it anywhere.
COMPANY_NAME="Softmato Technology Pvt Ltd"
COMPANY_PAN=
COMPANY_ADDRESS=
COMPANY_EMAIL=                # where contact enquiries are delivered
COMPANY_PHONE=

# ── Core ───────────────────────────────────────────────────
NODE_ENV=development
APP_ENV=local
DATABASE_URL=postgresql://postgres:softmato@localhost:5432/softmato_dev

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
USE_QUEUE=false

# ── Security ───────────────────────────────────────────────
AUTH_SECRET=                  # openssl rand -base64 32
AUTH_URL=http://localhost:3000
CRON_SECRET=                  # bearer for /api/jobs/*
ENCRYPTION_KEY=               # 32 bytes hex, AES-256-GCM, for TOTP secrets

# ── Domains ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CHECKOUT_URL=http://payment.localhost:3000

# ── Payment providers ──────────────────────────────────────
PAYMENT_MODE=sandbox

ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=
ESEWA_BASE_URL=https://rc-checkout.esewa.com.np

KHALTI_SECRET_KEY=
KHALTI_BASE_URL=https://dev.khalti.com/api/v2

FONEPAY_MERCHANT_CODE=
FONEPAY_SECRET_KEY=
FONEPAY_PG_URL=
FONEPAY_QR_URL=
FONEPAY_ENABLED=false

# ── Storage (Cloudflare R2) ────────────────────────────────
# All five of the public-bucket variables or none of them: the app refuses to
# boot on a partial set rather than failing at the first upload.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=softmato-data-public
R2_PUBLIC_BASE_URL=           # https://pub-<hash>.r2.dev, or a custom domain

# Optional. Derived from R2_ACCOUNT_ID when unset.
R2_ENDPOINT=                  # https://<account_id>.r2.cloudflarestorage.com
# Phase 3 onwards — payment proofs, invoice PDFs. Presigned access only.
R2_PRIVATE_BUCKET=softmato-data-private

# ── Services ───────────────────────────────────────────────
# Email is optional as a group: a missing key costs a notification, never an
# enquiry. There is no EMAIL_FROM — the sender is assembled per message from
# the domain below and the message's category (docs/EMAIL_SYSTEM.md), so
# billing mail leaves as billing@ and an alert as alert@.
RESEND_API_KEY=
# A bare hostname, and it must be verified in Resend. Unset uses softmato.com.
EMAIL_DOMAIN=softmato.com
# Optional override. Leave blank: info@EMAIL_DOMAIN is derived, and a derived
# address cannot point at a domain we do not own.
EMAIL_REPLY_TO=
SENTRY_DSN=
