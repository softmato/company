# ── Company ────────────────────────────────────────────────
# Legal name is not final. Never hardcode it anywhere.
COMPANY_NAME="Softmato Technology Pvt Ltd"
COMPANY_PAN=
COMPANY_ADDRESS=
COMPANY_EMAIL=                # where contact enquiries are delivered
COMPANY_PHONE=

# ── Core ───────────────────────────────────────────────────
NODE_ENV=development
APP_ENV=local
DATABASE_URL=postgresql://postgres:softmato@localhost:5432/softmato_dev

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
USE_QUEUE=false

# ── Security ───────────────────────────────────────────────
AUTH_SECRET=                  # openssl rand -base64 32
AUTH_URL=http://localhost:3000
CRON_SECRET=                  # bearer for /api/jobs/*
ENCRYPTION_KEY=               # 32 bytes hex, AES-256-GCM, for TOTP secrets

# ── Domains ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CHECKOUT_URL=http://payment.localhost:3000

# ── Payment providers ──────────────────────────────────────
# Which adapters the composition root registers (lib/payments/providers.ts).
#
#   mock     MockProviderAdapter for eSewa and Khalti. Nothing reaches a
#            gateway. This is the ONLY setting under which a payment may be
#            faked — a missing credential never fakes one.
#   sandbox  Real adapters, provider sandbox hosts.
#   live     Real adapters, provider live hosts.
#
# A provider whose credentials are absent is not registered, so it is never
# offered on a checkout page. Boot fails if that leaves nobody able to charge.
PAYMENT_MODE=sandbox            # 'mock' | 'sandbox' | 'live'

# Providers return the customer to NEXT_PUBLIC_CHECKOUT_URL/checkout/<id>/callback.
# There are no webhook endpoints: Khalti never pushes, and eSewa returns the
# customer's browser rather than calling us server to server.

# eSewa. These sandbox values are eSewa's own published test credentials, so
# this provider works out of the box against rc-epay. Both or neither.
#
# The key MUST be quoted: it contains '&', ':' and '/', and an unquoted value
# is truncated at the '&' by some dotenv readers, which yields ES104
# "Invalid payload signature" from eSewa rather than a parse error.
#
# This repo previously recorded '8gBwcE4DOHB28vvi' here. That key is not
# eSewa's and never was; rc-epay rejects every signature made with it. Verified
# 2026-09-02 by posting the v2 form with both: the value below returns a 302
# into the payment page, the old one returns ES104.
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY="8gBm/:&EnhH.1/q"
ESEWA_BASE_URL=                 # optional; overrides the host for ESEWA_ENV
ESEWA_ENV=sandbox               # 'sandbox' | 'live' — 'live' requires PAYMENT_MODE=live

# Khalti. The value below is the shared sandbox test key Khalti publishes in
# its own integration examples, so Khalti also works out of the box. Verified
# 2026-09-02 against dev.khalti.com: /epayment/initiate/ returns a pidx and a
# test-pay.khalti.com payment_url.
#
# For a merchant-specific sandbox key instead, sign up at test-admin.khalti.com
# (login OTP 987654) and copy the 'live secret key' from that dashboard — Khalti
# names the sandbox key 'live_secret_key' too, which is confusing and expected.
KHALTI_SECRET_KEY=live_secret_key_68791341fdd94846a146f0457ff7b455
KHALTI_BASE_URL=                # optional; overrides the host for KHALTI_ENV
KHALTI_ENV=sandbox              # 'sandbox' | 'live' — 'live' requires PAYMENT_MODE=live

# Fonepay is NOT configurable, because it is not implemented. Its adapter
# throws on every call and the composition root never registers it. It is
# gated on the bank's integration document (PHASES.md Phase 9) — do not guess
# at its request shapes, and do not re-add credentials here until that document
# exists.

# ── Storage (Cloudflare R2) ────────────────────────────────
# All five of the public-bucket variables or none of them: the app refuses to
# boot on a partial set rather than failing at the first upload.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=softmato-data-public
R2_PUBLIC_BASE_URL=           # https://pub-<hash>.r2.dev, or a custom domain

# Optional. Derived from R2_ACCOUNT_ID when unset.
R2_ENDPOINT=                  # https://<account_id>.r2.cloudflarestorage.com
# Payment proofs, and the rendered invoice and receipt PDFs. Never public.
# Needs the account id and the key pair above; naming a bucket without them
# fails at boot rather than at the first invoice. Unset is supported — every
# document is then rendered on demand, exactly as before it was stored.
R2_PRIVATE_BUCKET=softmato-data-private

# ── Documents ──────────────────────────────────────────────
# Optional, and only useful locally. A Chrome or Edge here renders invoice and
# receipt PDFs; without it the app looks in the standard install locations, and
# in production falls back to the Chromium bundled into the deployment. With no
# engine at all a PDF download returns the HTML with an X-Softmato-PDF-Fallback
# header, which still prints correctly — never an error.
CHROME_PATH=

# ── Services ───────────────────────────────────────────────
# Email is optional as a group: a missing key costs a notification, never an
# enquiry. There is no EMAIL_FROM — the sender is assembled per message from
# the domain below and the message's category (docs/EMAIL_SYSTEM.md), so
# billing mail leaves as billing@ and an alert as alert@.
RESEND_API_KEY=
# A bare hostname, and it must be verified in Resend. Unset uses softmato.com.
EMAIL_DOMAIN=softmato.com
# Optional override. Leave blank: info@EMAIL_DOMAIN is derived, and a derived
# address cannot point at a domain we do not own.
EMAIL_REPLY_TO=
SENTRY_DSN=

# ── AI & LLM Engine (imported from reference project ai_local/server) ──
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash
GROQ_API_KEY=
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_LIGHT_MODEL_NAME=mistralai/mistral-7b-instruct
OPENROUTER_REASONING_MODEL_NAME=meta-llama/llama-3.3-70b-instruct
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=ai-assistant-index
PINECONE_METADATA_NAMESPACE=ai-assistant-namespace

