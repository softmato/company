{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@softmato/web", "dev"],
      "port": 3000
    },
    {
      "name": "web-3001",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@softmato/web",
        "exec",
        "next",
        "dev",
        "-p",
        "3001"
      ],
      "port": 3001
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@softmato/web", "start", "-p", "3100"],
      "port": 3100
    }
  ]
}
