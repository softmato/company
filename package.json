{
  "name": "softmato",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @softmato/db generate",
    "db:migrate": "pnpm --filter @softmato/db migrate",
    "db:seed": "pnpm --filter @softmato/db seed",
    "admin:create": "tsx --env-file-if-exists=.env.local ./scripts/create-admin.mts",
    "admin:totp": "tsx --env-file-if-exists=.env.local ./scripts/admin-totp.mts",
    "admin:enrol": "tsx --env-file-if-exists=.env.local ./scripts/admin-enrol.mts",
    "cms:publish-all": "tsx --env-file-if-exists=.env.local ./scripts/publish-all.mts",
    "cms:sync-copy": "tsx --env-file-if-exists=.env.local ./scripts/sync-cms-copy.mts",
    "brand:build": "tsx ./scripts/build-brand-assets.mts",
    "settings:set": "tsx --env-file-if-exists=.env.local ./scripts/set-setting.mts",
    "legal:check": "tsx --env-file-if-exists=.env.local ./scripts/check-legal.mts",
    "legal:todo": "tsx --env-file-if-exists=.env.local ./scripts/legal-todo.mts",
    "legal:refresh": "tsx --env-file-if-exists=.env.local ./scripts/refresh-legal.mts",
    "predeploy": "pnpm typecheck && pnpm test && pnpm legal:check",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\""
  },
  "pnpm": {
    "overrides": {
      "@smithy/types": "4.17.2",
      "@smithy/core": "3.33.3"
    }
  },
  "devDependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@softmato/db": "workspace:^",
    "drizzle-orm": "^0.38.3",
    "otpauth": "^9.5.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
